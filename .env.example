# AI provider for /api/ai
# Leave everything unset to use the keyless free provider (Pollinations).
# Set one key below to use that provider instead — it is picked up automatically.

# GROQ_API_KEY=            # https://console.groq.com/keys (free tier)
# OPENROUTER_API_KEY=      # https://openrouter.ai/keys (has :free models)
# GEMINI_API_KEY=          # https://aistudio.google.com/apikey (free tier)
# NVIDIA_API_KEY=          # https://build.nvidia.com

# Optional overrides
# AI_PROVIDER=groq         # pollinations | groq | openrouter | gemini | nvidia
# AI_MODEL=
